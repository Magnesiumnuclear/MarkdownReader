# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# 虛擬環境
.venv/
venv/
env/
ENV/
.python-version

# 套件與打包中繼資料
*.egg-info/
.eggs/
pip-wheel-metadata/

# 工具快取
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# PyInstaller
# ---------------------------------------------------------------------------
# build/ 是分析與中繼產物，dist/ 是打包好的 exe，兩者都可以重新產生。
build/
dist/

# 【重要】不要寫成 *.spec —— build.spec 是本專案的打包設定，屬於原始碼。
# 用 CLI 形式打包（帶 --name MarkdownReader）時，PyInstaller 會自動產生一份
# MarkdownReader.spec，那份才是拋棄式的中繼檔，只忽略它。
MarkdownReader.spec

# ---------------------------------------------------------------------------
# 本專案的產生物
# ---------------------------------------------------------------------------
# app.ico 由 tools/make_icon.py 從 assets/icons/app.svg 產生，
# build.ps1 也會在缺少時自動重建，因此視為產生物不納入版控。
#   重新產生： py -3.13 tools/make_icon.py
#   若想改為納入版控： git add -f assets/app.ico
assets/app.ico

# 注意：assets/sample.png 是 sample.md 用來測試圖片縮放的測試素材，
# 沒有它 sample.md 的圖片連結會失效，所以「要」納入版控，不要加進這裡。

# ---------------------------------------------------------------------------
# 執行期輸出
# ---------------------------------------------------------------------------
# 程式的錯誤紀錄實際寫在 %LOCALAPPDATA%\MarkdownReader\error.log，
# 不會落在專案內；這裡只是保險，避免手動測試時把記錄倒進工作目錄。
*.log

# ---------------------------------------------------------------------------
# 編輯器與 IDE
# ---------------------------------------------------------------------------
.vscode/
.idea/
.trae/
*.code-workspace
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Windows
# ---------------------------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump
