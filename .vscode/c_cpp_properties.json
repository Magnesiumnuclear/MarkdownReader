{
    // IntelliSense 設定：對準實際拿來編轉交器的那顆編譯器（MSYS2 UCRT64 g++），
    // 語意檢查、標頭解析才會和 build.ps1 的第 5 步一致。
    // 注意不要選成 MSYS2 底下其他環境（mingw64/clang64）——這台機器只裝了 ucrt64。
    "configurations": [
        {
            "name": "Win32 (MSYS2 UCRT64)",
            // CMake 設定過之後，IntelliSense 直接採用 CMake 的編譯資料庫
            // （最準確）；還沒設定時退回下面的靜態欄位。
            "configurationProvider": "ms-vscode.cmake-tools",
            "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "defines": [
                "UNICODE",
                "_UNICODE",
                "WIN32_LEAN_AND_MEAN"
            ]
        }
    ],
    "version": 4
}
